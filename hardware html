.sub{color:var(--mu);margin:0 0 20px}
h2{font-size:1rem;margin:0 0 12px;color:var(--mu);font-weight:600}
.panel{background:var(--sf);border:1px solid var(--ln);border-radius:14px;padding:16px;margin-bottom:16px}
.grid{display:grid;gap:14px;grid-template-columns:1fr}
