.srch{display:flex;gap:8px}.srch select{width:auto}.cnt{color:var(--mu);font-size:.8rem;margin:8px 0 0}
.cards{display:grid;gap:8px;grid-template-columns:1fr 1fr;margin-top:8px;max-height:420px;overflow:auto;padding-right:2px}
.card{text-align:left;background:var(--sf2);color:var(--tx);border:1px solid var(--ln);border-radius:10px;padding:10px;cursor:pointer;font:inherit}
.card small{display:block;color:var(--mu);font-size:.75rem}
.card:hover{border-color:var(--ac)}
.card[aria-pressed=true]{border-color:var(--ac);background:#27335c}
.empty{color:var(--mu);grid-column:1/-1;margin:6px 0}
.badge{border-radius:14px;border:2px solid;padding:20px 18px;margin-bottom:16px}
.badge .ic{font-size:2.4rem;line-height:1}
.badge h3{margin:8px 0 4px;font-size:clamp(1.3rem,4.5vw,1.8rem);line-height:1.2}
.badge p{margin:0;color:var(--tx);opacity:.85}
.b3,.b2{border-color:var(--g);background:var(--gb);color:var(--g)}
.b1{border-color:var(--y);background:var(--yb);color:var(--y)}
.b0{border-color:var(--r);background:var(--rb);color:var(--r)}
.badge p{color:var(--tx)}
.row{padding:12px 0;border-top:1px solid var(--ln)}
.row:first-of-type{border-top:0;padding-top:0}
.rt{display:flex;justify-content:space-between;gap:8px;align-items:baseline;flex-wrap:wrap}
.rt b{font-size:1rem}
.chip{font-size:.78rem;font-weight:700;padding:2px 9px;border-radius:99px}
.c0{background:var(--rb);color:var(--r)}.c1{background:var(--yb);color:var(--y)}.c2,.c3{background:var(--gb);color:var(--g)}
.you{color:var(--mu);font-size:.85rem;margin:2px 0 8px}
.track{position:relative;height:12px;border-radius:99px;background:var(--sf2)}
.fill{height:100%;border-radius:99px}
.f0{background:var(--r)}.f1{background:var(--y)}.f2,.f3{background:var(--g)}
.tick{position:absolute;top:-4px;width:2px;height:20px;background:var(--tx);opacity:.7}
.leg{display:flex;justify-content:space-between;color:var(--mu);font-size:.75rem;margin-top:6px;gap:8px}
.ad{border:1px dashed var(--ln);border-radius:12px;padding:14px;margin-top:8px;color:var(--mu);font-size:.9rem}
.ad .tag{font-size:.7rem;color:var(--mu);display:block;margin-bottom:6px}
.ad a{display:inline-block;margin-top:8px;background:var(--ac);color:#0e1320;font-weight:700;text-decoration:none;padding:8px 14px;border-radius:9px}
