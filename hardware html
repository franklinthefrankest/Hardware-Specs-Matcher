label{display:block;font-size:.85rem;color:var(--mu);margin-bottom:4px}
select,input[type=search]{width:100%;background:var(--sf2);color:var(--tx);border:1px solid var(--ln);border-radius:10px;padding:11px 12px;font:inherit}
