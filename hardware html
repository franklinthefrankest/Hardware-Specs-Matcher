  const gm=GAMES[cur],u={c:CPUS[$("cpu").value][1],g:GPUS[$("gpu").value][1],r:RAMS[$("ram").value],s:STOS[$("sto").value][1]};
  const rows=[
   {k:"CPU",you:CPUS[$("cpu").value][0],key:"c",min:gm.min.c,rec:gm.rec.c,mt:gm.min.ct,rt:gm.rec.ct},
   {k:"GPU",you:GPUS[$("gpu").value][0],key:"g",min:gm.min.g,rec:gm.rec.g,mt:gm.min.gt,rt:gm.rec.gt},
   {k:"RAM",you:u.r+" GB",key:"r",min:gm.min.r,rec:gm.rec.r,mt:gm.min.r+" GB",rt:gm.rec.r+" GB"},
   {k:"Storage",you:STOS[$("sto").value][0],key:"s",min:gm.min.s,rec:gm.rec.s,mt:stoText(gm.min.s),rt:stoText(gm.rec.s)}
  ].map(r=>({...r,v:u[r.key],st:status(u[r.key],r.min,r.rec)}));
  const worst=Math.min(...rows.map(r=>r.st));
  render(gm,rows,Math.min(worst,2),u);
}

/* ---------- RENDER ---------- */
function render(gm,rows,lvl,u){
  const B={2:["✔","Can Run Smoothly - Recommended Specs Met","Your PC meets or beats the recommended specs for "+gm.n+"."],
           1:["⚠","Can Run on Low Settings - Minimum Specs Met","Your PC clears the minimum for "+gm.n+", but falls below recommended in: "+rows.filter(r=>r.st<2).map(r=>r.k).join(", ")+"."],
           0:["✖","Cannot Run - Upgrade Required","Below the minimum for "+gm.n+": "+rows.filter(r=>r.st===0).map(r=>r.k).join(", ")+"."]}[lvl];
  $("badge").className="badge b"+lvl;
  $("badge").innerHTML=`<div class="ic" aria-hidden="true">${B[0]}</div><h3>${B[1]}</h3><p>${B[2]}</p>`;
  $("rows").innerHTML=rows.map(r=>{
    const sc=Math.max(r.rec*1.4,r.v*1.05),pc=x=>Math.min(100,x/sc*100).toFixed(1);
    return `<div class="row"><div class="rt"><b>${r.k}</b><span class="chip c${r.st}">${LABELS[r.st]}</span></div>
    <div class="you">You: ${r.you}</div>
    <div class="track" role="img" aria-label="${r.k}: ${LABELS[r.st]}"><div class="fill f${r.st}" style="width:${pc(r.v)}%"></div><i class="tick" style="left:${pc(r.min)}%"></i><i class="tick" style="left:calc(${pc(r.rec)}% - 2px)"></i></div>
    <div class="leg"><span>Min: ${r.mt}</span><span>Rec: ${r.rt}</span></div></div>`}).join("");
  ads(gm,rows,u);
}

// Ad / affiliate slot. Replace href="#" with your affiliate links, or drop in an ad network snippet.
function ads(gm,rows,u){
  let h;
  const gpuRow=rows[1],ramRow=rows[2];
  if(gpuRow.st<2){
    const t=GPUS.filter(x=>x[1]>=gm.rec.g).sort((a,b)=>a[1]-b[1])[0]||GPUS[GPUS.length-1];
    h=`<strong>Recommended GPU upgrade:</strong> ${t[0]}<br>The most affordable card in our list that reaches the recommended level for ${gm.n}.<br><a href="#" rel="sponsored noopener" target="_blank">Check price</a>`;
  }else if(ramRow.st<2){
    const t=RAMS.find(x=>x>=gm.rec.r);
    h=`<strong>Recommended RAM upgrade:</strong> ${t} GB kit<br>Gets your memory to the recommended level for ${gm.n}.<br><a href="#" rel="sponsored noopener" target="_blank">Check price</a>`;
  }else h=`<strong>Gear for ${gm.n}</strong><br>Your specs are covered. Looking for a monitor or SSD upgrade?<br><a href="#" rel="sponsored noopener" target="_blank">Browse picks</a>`;
  $("ad").innerHTML=`<span class="tag">Sponsored</span>${h}`;
}

function cards(){
  const q=$("q").value.trim().toLowerCase();
  const tf=$("tf").value;
  const list=GAMES.map((x,i)=>[x,i]).filter(([x])=>(!tf||x.t===tf)&&x.n.toLowerCase().includes(q));
  $("cnt").textContent=list.length+" of "+GAMES.length+" titles";
  $("cards").innerHTML=list.length?list.map(([x,i])=>`<button class="card" data-i="${i}" aria-pressed="${i===cur}">${x.n}<small>${x.t}</small></button>`).join(""):`<p class="empty">No match. Try another name.</p>`;
}

/* ---------- EVENTS ---------- */
$("cards").addEventListener("click",e=>{const b=e.target.closest(".card");if(!b)return;cur=+b.dataset.i;cards();calc()});
$("q").addEventListener("input",cards);
$("tf").addEventListener("change",cards);
["cpu","gpu","ram","sto"].forEach(id=>$(id).addEventListener("change",()=>{$("preset").value=0;calc()}));
$("preset").addEventListener("change",e=>{
  const p=PRESETS[e.target.value][1];if(!p)return;
  $("cpu").value=p[0];$("gpu").value=p[1];$("ram").value=p[2];$("sto").value=p[3];calc();
});

/* ---------- INIT ---------- */
$("preset").value=3;$("preset").dispatchEvent(new Event("change"));cards();calc();
</script>
</body>
