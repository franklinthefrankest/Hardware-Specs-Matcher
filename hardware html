<div class="wrap">
  <h1>Can I Run It? <span>Hardware Specs Matcher</span></h1>
  <p class="sub">Pick your PC parts, choose a game or app, and get an instant verdict.</p>

  <div class="main">
    <div class="left">
      <section class="panel" aria-labelledby="h-spec">
        <h2 id="h-spec">Your PC</h2>
        <div class="preset"><label for="preset">Quick preset</label><select id="preset"></select></div>
        <div class="grid">
          <div><label for="cpu">CPU (processor)</label><select id="cpu"></select></div>
          <div><label for="gpu">GPU (graphics card)</label><select id="gpu"></select></div>
          <div><label for="ram">RAM</label><select id="ram"></select></div>
          <div><label for="sto">Storage type</label><select id="sto"></select></div>
        </div>
      </section>

      <section class="panel" aria-labelledby="h-game">
        <h2 id="h-game">Game or software</h2>
        <label for="q" class="sr" style="position:absolute;left:-9999px">Search</label>
        <div class="srch"><input type="search" id="q" placeholder="Search games and apps" autocomplete="off"><label for="tf" style="position:absolute;left:-9999px">Filter by type</label><select id="tf"><option value="">All</option><option>Game</option><option>Software</option></select></div>
        <p class="cnt" id="cnt"></p>
        <div class="cards" id="cards"></div>
      </section>
    </div>

    <div class="right">
      <div id="badge" class="badge" role="status" aria-live="polite"></div>
      <section class="panel" aria-labelledby="h-bd">
        <h2 id="h-bd">Component breakdown</h2>
        <div id="rows"></div>
        <p class="leg" style="margin-top:12px"><span>White marks on each bar: minimum (left) and recommended (right).</span></p>
      </section>
      <aside class="ad" id="ad" aria-label="Sponsored recommendation"></aside>
    </div>
  </div>
</div>

